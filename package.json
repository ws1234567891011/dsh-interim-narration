{
  "name": "dsh-interim-narration",
  "version": "0.3.2",
  "description": "让 DeepSeek Harness 的 agent 每轮先讲理解与计划、在工具调用之间用正文写过程叙述（边做边说），并在「插件 → 本插件 → 配置」里直接调整参数；系统提示末尾还有一条短提醒，长任务也不会只顾调工具不说话",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs",
    "test:host": "node test/smoke.mjs",
    "test:client": "node test/client-smoke.mjs",
    "mock": "node test/mock-llm.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "narration",
    "transcript",
    "process"
  ],
  "author": "ws1234567891011",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ws1234567891011/dsh-interim-narration.git"
  },
  "homepage": "https://github.com/ws1234567891011/dsh-interim-narration#readme",
  "bugs": {
    "url": "https://github.com/ws1234567891011/dsh-interim-narration/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
