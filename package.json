{
  "name": "dsh-interim-narration",
  "version": "0.10.3",
  "description": "让 DeepSeek Harness 的 agent 每轮先讲理解与计划，并在工具调用之间用正文写过程叙述（边做边说）；在「设置 → 过程叙述」里可调档位、语言与开关，静默步骤会自动加压。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "screenshots.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs && node test/pack-smoke.mjs",
    "test:host": "node test/smoke.mjs",
    "test:client": "node test/client-smoke.mjs",
    "test:pack": "node test/pack-smoke.mjs",
    "test:e2e": "node test/e2e.mjs",
    "mock": "node test/mock-llm.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "narration",
    "transcript",
    "process"
  ],
  "author": "ws1234567891011",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ws1234567891011/dsh-interim-narration.git"
  },
  "homepage": "https://github.com/ws1234567891011/dsh-interim-narration#readme",
  "bugs": {
    "url": "https://github.com/ws1234567891011/dsh-interim-narration/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.0 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  }
}
